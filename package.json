{
  "name": "eslint-plugin-one-function-per-file",
  "version": "0.1.0",
  "description": "ESLint plugin and preset that enforce one function per file, const arrow functions only, and a TSDoc comment on every named function.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "eslint-config",
    "flat-config",
    "one-function-per-file",
    "single-responsibility",
    "arrow-functions",
    "tsdoc",
    "jsdoc",
    "code-style"
  ],
  "homepage": "https://github.com/Vaporjawn/eslint-plugin-one-function-per-file#readme",
  "bugs": {
    "url": "https://github.com/Vaporjawn/eslint-plugin-one-function-per-file/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaporjawn/eslint-plugin-one-function-per-file.git"
  },
  "license": "MIT",
  "author": "Victor Williams <victor.williams.dev@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run verify:package",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run build && eslint .",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:package": "publint --strict && attw --pack . --profile esm-only && node scripts/smoke.mjs"
  },
  "dependencies": {
    "eslint-plugin-jsdoc": "^65.5.4",
    "eslint-plugin-tsdoc": "^0.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
